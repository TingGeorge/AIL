    $(function () {
        $(".calendar-date-start .datepicker").datepicker({
            dateFormat: "yy-mm-dd",
            showOn: "button",
            buttonImage: "images/icon/calendar.svg",
            buttonText: "月曆按鈕", /*月曆按鈕*/
            onClose: function (selectedDate) {
                $(".datepicker ").datepicker("option", selectedDate);
