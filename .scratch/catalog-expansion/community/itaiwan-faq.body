    <script>
        function screencheck() {
		console.log('screencheck function executed');
            if (window.orientation == 180 || window.orientation == 0 || $(window).width() < $(window).height()) {
                // console.log("豎屏狀態!")
                $('.item-img-md').hide();
                $('.item-img-xs').show();
            }
            if (window.orientation == 90 || window.orientation == -90 || $(window).width() > $(window).height()) {
			console.log('Landscape mode detected');
                // console.log("橫屏狀態!")
                $('.item-img-md').show();
                $('.item-img-xs').hide();
            }
        }
		$(".navbar-xs-btn").on("click",function (e) {
			var _win_w = $(window).width();
			// console.log(_win_w);
			console.log('1')
			if (_win_w<=767) {
			  // e.stopPropagation();
			  $(".app-navbar-header .dropdown-menu>.nav>li>a").on("click",function (e) {
				e.stopPropagation();
				// $(this).parent().parent().find('.dropdown').removeClass('open');
				// $(".app-navbar-header .nav-nemu").addClass('open');
				$(this).parent().toggleClass('show');
				// 
			  })
			}
			$(this).parent().toggleClass('show');
		})
			
		$(window).scroll(function(event){
			var _win_w = $(window).width();
			var _nav_menu_item = $('.nav-nemu .dropdown.show');
			// console.log(event);
			if (_win_w>=768) {
			  _nav_menu_item.removeClass('show');
			  // $(".dropdown>a:focus").blur();
			}else{
			  // 
			}
			// _nav_menu_item.find('.dropdown-menu').hide();
		  });
    </script>


    
