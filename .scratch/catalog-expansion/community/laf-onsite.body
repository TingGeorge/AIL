<script>
  new TwCitySelector({
    el: '.city-selector',
    elCountry: '#country',
    elDistrict: '#district',
  });
  $(function () {
    //快速篩選
    /*$("input[name=keyword]").on("keyup", function() {
      var value = $(this).val().toLowerCase();
      $(".tsearch tr").slice(1).filter(function() {
        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
      });
     
      $(".mobile-item").slice(0).filter(function() {
        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
      });
    });*/
    //服務類型
    /* $("input[name=adviceType]").on("click", function() {
       $(".tsearch tr").removeClass("kk");
       $(".mobile-item").removeClass("kk");
       var num2 = $('input[name=adviceType]:checked').length;
       if(num2==0){
         $(".tsearch tr").show();
         $(".mobile-item").show();
         
       }else{
         $("input[name='adviceType']:checked").each(function(index, item) {

         var prdid = $(item).val();
         
         $(".tsearch tr").slice(1).hide();

         $(".tsearch tr").slice(1).filter(":contains("+ prdid.trim() +")").addClass("kk");
         $(".tsearch tr.kk").show();
         $(".mobile-item").slice(0).hide();
         $(".mobile-item").slice(0).filter(":contains("+ prdid.trim() +")").addClass("kk");
         $(".mobile-item.kk").show();
      });
       }
       
       
     });*/

    $("#search_place").on("click", function () {
      //服務類型
      var prd_data = [];
      var arrayO = {};
      //縣市
      var county = '';
      //區域
      var district = '';
      //服務時段
      var tz = [];
      //預約方式
      var reservationType = [];
      //關鍵字
      var keyword = '';

      county = $("select[name=county]").val();
      district = $("select[name=district]").val();
      //  ta=$("select[name=ta]").val();
      //  reservationType=$("select[name=reservationType]").val();
      keyword = $("input[name=keyword]").val();
      var ckprdnum = $("input[name='adviceType']:checked").length;
      if (ckprdnum > 0) {
        $("input[name='adviceType']:checked").each(function (index, item) {

          var prdid = $(item).val();
          prd_data.push(prdid);
        });
      }
      //20240221
      var ckprdnum2 = $("input[name='tz']:checked").length;
      if (ckprdnum2 > 0) {
        $("input[name='tz']:checked").each(function (index, item) {

          var prdid2 = $(item).val();
          tz.push(prdid2);
        });
      }
      var ckprdnum3 = $("input[name='reservationType']:checked").length;
      if (ckprdnum3 > 0) {
        $("input[name='reservationType']:checked").each(function (index, item) {

          var prdid3 = $(item).val();
          reservationType.push(prdid3);
        });
      }
      arrayO = {};
      arrayO['prd_data'] = prd_data;
      arrayO['county'] = county;
      arrayO['district'] = district;
      arrayO['tz'] = tz;
      arrayO['reservationType'] = reservationType;
      arrayO['keyword'] = keyword;
      //  console.log(arrayO);
      $.ajax({
        type: "POST",
        url: "ajax/sec_place.php",
        dataType: "json",
        data: arrayO,
        success: function (msg) {
          // alert(msg.csatus);
          // alert(msg.search_debug);
          //  console.log(msg.search_debug);
          if (msg.csatus.trim() != 'no') {
            $("#srehtm").html(msg.htmla);
            $(".mobile-table").html(msg.htmlb);

            // alert("批次處理完成!");
            //  console.log(msg.search_debug);
            // alert("處理成功!");

          } else {
            alert("處理失敗!");
          }
        }
      });
    });
    //
    $("#search_place").trigger("click");
  });
</script><footer>
