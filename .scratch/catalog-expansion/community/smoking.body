                });
                //tab展開-->
                $('.colorBox a').focus(function () {
                    $('.colorControl').show();
                });
                $('.colorBox .pink').focusout(function () {
                    $('.colorControl').hide();
                });
                //FlexSlider
                $('.flexslider').flexslider({
                    animation: "fade",
                    startAt: 0,
                    slideshow: true,
                    slideshowSpeed: 2000,
                    animationSpeed: 1000,
                    pauseOnAction: true,
                    pauseOnHover: true,
                    directionNav: false,
                    pausePlay: true

                });
                //slick slider的js
                $(document).on('ready', function () {
                    $(".themeList").slick({
                        dots: false,
                        infinite: true,
                        slidesToShow: 5,
                        slidesToScroll: 1,
                        responsive: [
                            {
