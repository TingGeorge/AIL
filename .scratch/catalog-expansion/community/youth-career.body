<!-- 主要服務 -->


<section class="main-sections">
    
    <div class="frame frame-sm">
        <div class="header">
            <a class="a11y-guidepoint" id="pageCenter" href="#pageCenter" accesskey="C" title="中央內容區塊">:::</a>
            <div class="deco" style="width: auto">
                <div class="heading-icon"><img src="/wdaecPublic/assets/img/deco-title.png" alt=""></div>
            </div>
            <div class="content">
                <h2 class="cht">選擇您所需要的服務</h2>
                <div class="eng" aria-hidden="true">Choose a Service</div>
            </div>
        </div>
        <div class="desc">符合 18-29 歲的青年，五個步驟輕鬆完成預約</div>
        <dl class="main-list">
            <dt>
                <div class="main-list-img-container">
                    <img src="/wdaecPublic/assets/img/img-service_v1.svg" alt="真人一對一即時線上諮詢">
                </div>
            </dt>
            <dd class="">
                <div class="main-list-title main-list-title-secondary">
                    真人一對一即時線上諮詢
                </div>
                <div class="main-list-txt">
                    由專業諮詢顧問提供每年3次免費<br>
                    線上一對一即時諮詢
                </div>
                <button type="button" id="btnGoToYouthCounsel" class="cs-card-list-item-btn" title="前往「真人一對一即時線上諮詢」區塊">立即前往 ➡</button>
            </dd>
        </dl>
        <dl class="main-list">
            <dt>
                <div class="main-list-img-container">
                    <img src="/wdaecPublic/assets/img/img-service_v2.svg" alt="真人線上團體諮詢講座">
                </div>
            </dt>
            <dd class="">
                <div class="main-list-title main-list-title-primary">
                    真人線上團體諮詢講座
                </div>
                <div class="main-list-txt ">
                    依職場風向提供免費 <br>
                    職涯發展及產業諮詢講座
                </div>
                <button type="button" id="btnGoToGroupCounsel" class="cs-card-list-item-btn" title="前往「真人線上團體諮詢講座」區塊">立即前往 ➡</button>
            </dd>
        </dl>
    </div>

    <div class="steps-block">
        <div class="step">
            <div class="icon">
                <div class="square"><img src="/wdaecPublic/assets/img/square-transparent.png" alt=""></div>
                <div class="num">1</div><i class="fas fa-sign-in-alt"></i>
            </div>
            <div class="text">登入／註冊</div>
        </div>
        <div class="step">
            <div class="icon">
                <div class="square"><img src="/wdaecPublic/assets/img/square-transparent.png" alt=""></div>
                <div class="num">2</div><i class="fas fa-clipboard-check"></i>
            </div>
            <div class="text">確認同意書</div>
        </div>
        <div class="step">
            <div class="icon">
                <div class="square"><img src="/wdaecPublic/assets/img/square-transparent.png" alt=""></div><i class="fas fa-calendar-alt"></i>
                <div class="num">3</div>
            </div>
            <div class="text">選擇<span class="d-inline-block">預約時間</span></div>
        </div>
        <div class="step">
            <div class="icon">
                <div class="square"><img src="/wdaecPublic/assets/img/square-transparent.png" alt=""></div><i class="fas fa-file-upload"></i>
                <div class="num">4</div>
            </div>
            <div class="text">
                填寫問題或
                <div class="d-inline-block">上傳附件</div>
            </div>
        </div>
        <div class="step">
            <div class="icon">
                <div class="square"><img src="/wdaecPublic/assets/img/square-transparent.png" alt=""></div>
                <div class="num">5</div><i class="fas fa-user-check"></i>
            </div>
            <div class="text">完成預約</div>
        </div>
    </div>
</section>
<script src="/wdaecPublic/DynamicInlineJS?js=Home/Index:JS-4"></script>


<!-- 1對1職涯諮詢 -->

<section class="services" id="YouthCounsel">
    <div class="frame">
        <div class="header">
            <a class="a11y-guidepoint" id="pageCenter" href="#pageCenter" accesskey="C" title="中央內容區塊">:::</a>
            <div class="deco"><img src="/wdaecPublic/assets/img/deco-title.png" alt=""></div>
            <div class="content">
                <h2 class="cht">一對一職涯諮詢</h2>
                <div class="eng" aria-hidden="true">Career Counseling</div>
            </div>
        </div>
    </div>
    <div id="anchor-go"></div>
    <div class="service-block">
        <a class="item" href="/wdaecPublic/apply/agreement?type=A" title="預約「探索職涯目標」諮詢">
            <div class="title">探索職涯目標</div>
            <div class="detail">認識自我 / 完善職涯規劃 / 職場認識 / 評估自我能力與職缺需求落差</div>
        </a>
        <a class="item" href="/wdaecPublic/apply/agreement?type=B" title="預約「履歷自傳診斷」諮詢">
            <div class="title">履歷自傳診斷</div>
            <div class="detail">履歷個人特色展現 / 求職目標分析</div>
        </a>
        <a class="item" href="/wdaecPublic/apply/agreement?type=C" title="預約「提升面試技巧」諮詢">
            <div class="title">提升面試技巧</div>
            <div class="detail">模擬面試 / 強化表達及傾聽能力</div>
        </a>
        <a class="item" href="/wdaecPublic/apply/agreement?type=D" title="預約「了解產業趨勢」諮詢">
            <div class="title">了解產業趨勢</div>
            <div class="detail">瞭解產業脈動 / 分析未來趨勢 / 評估產業是否與自己興趣能力相符</div>
        </a>
        <a class="item" href="/wdaecPublic/apply/agreement?type=E" title="預約「強化職場生存」諮詢">
            <div class="title">強化職場生存</div>
            <div class="detail">職場溝通技巧 / 換位思考 / 職場適應</div>
        </a>
        <a class="item" href="/wdaecPublic/front/extraInfo" title="查找其他就業相關資訊">
            <div class="title">查找其他就業相關資訊</div>
            <div class="detail">自我評估 / 職業探索 / 技能培訓 / 求職攻略 / 創業</div>
        </a>

    </div>
</section>


<!-- 團體諮詢 -->
<section class="services" id="GroupCounsel">
    
    <div class="frame">
        <div class="header">
            <div class="deco" style="width: auto">
                <div class="heading-icon"><img src="/wdaecPublic/assets/img/deco-title.png" alt=""></div>
            </div>
            <div class="content">
                <h2 class="cht">團體諮詢講座</h2>
                <div class="eng" aria-hidden="true">Group Counseling</div>
            </div>
        </div>
        <div class="header-more">
            <a href="/wdaecPublic/ApplyGC/" class="btn btn-info">
                更多活動列表&nbsp;
                <i class="fa fa-angle-double-right"></i>
            </a>
        </div>
    </div>

        <div class="service-block-one">
            <a class="item" title="目前無團體諮詢場次可報名">
                <div class="title c-pink">
                    <div class="mask mask_video"></div>
                    職涯發展講座
                    <br>
                    勾勒生涯願景求職大步走
                </div>
                <div class="detail">
                    敬請期待
                </div>
            </a>
        </div>

</section>
<section class="services">
    <!-- 首頁職涯嚮導 影音連結區塊 -->
    <div class="service-block-one">
        <a class="item" href="https://notes.taiwanjobs.gov.tw/" title="職涯手札：描繪你的職涯藍圖" target="_blank">
            <div class="title title-listento c-yellow">
                <div class="mask mask_video"></div>
                <div class="title-text">
                    職涯手札
                    <br>
                    描繪你的職涯藍圖
                </div>
                
            </div>
            <div class="detail">
                開始規劃你的職涯旅程！透過六個關鍵步驟，幫助你明確職業方向。 <br />
                藉由自我反思和深度探索，你將發現自己的興趣、能力和價值觀，並借助線上工具與資源，一步步制定和實踐職涯目標。
            </div>
        </a>
    </div>
</section>


<!--服務特色-->

<section class="features">
    <div class="frame" style="max-width:1050px;">
        <div class="header dark">
            <div class="deco"><img src="/wdaecPublic/assets/img/deco-title.png" alt=""></div>
            <div class="content">
                <h2 class="cht">服務特色</h2>
                <div class="eng" aria-hidden="true">Service Features</div>
            </div>
        </div>
        <div class="feature-block">
            <div class="item">
                <div class="deco"><img src="/wdaecPublic/assets/img/deco-feature-1.svg" alt=""></div>
                <div class="main">專業職涯顧問團隊</div>
                <div class="sub">每位顧問均有職涯諮詢相關專業認證</div>
            </div>
            <div class="item">
                <div class="deco"><img src="/wdaecPublic/assets/img/deco-feature-2.svg" alt=""></div>
                <div class="main">不受地點限制</div>
                <div class="sub">預約後可在任何有網路的地方進行諮詢</div>
            </div>
            <div class="item">
                <div class="deco"><img src="/wdaecPublic/assets/img/deco-feature-3.svg" alt=""></div>
                <div class="main">真人即時諮詢</div>
                <div class="sub">提供專業諮詢顧問與您1對1即時諮詢／團體諮詢講座</div>
            </div>
            <div class="item">
                <div class="deco"><img src="/wdaecPublic/assets/img/deco-feature-4.svg" alt=""></div>
                <div class="main">貼心後續追蹤</div>
                <div class="sub">我們會在諮詢後一個月對您的狀況進行追蹤</div>
            </div>
        </div>
    </div>
</section>


<!--諮詢方式-->

<section class="appointment">
    <div class="frame">
        <div class="header">
            <div class="deco"><img src="/wdaecPublic/assets/img/deco-title.png" alt=""></div>
            <div class="content">
                <h2 class="cht">諮詢方式</h2>
                <div class="eng" aria-hidden="true">Join an Appointment</div>
            </div>
        </div>
        <div class="appointment-block d-none d-md-block">
            <div class="step-1"><img src="/wdaecPublic/assets/img/step-1.png" alt=""></div>
            <div class="center-box">
                <div class="left">
                    <div class="point-frame">
                        <div class="num">1</div>
                        <div class="text">找到一個安靜的場所</div>
                    </div>
                    <div class="point-frame">
                        <div class="num">2</div>
                        <div class="text">確認網路環境穩定</div>
                    </div>
                    <div class="point-frame">
                        <div class="num">3</div>
                        <div class="text">準備支援影音的電子通訊設備</div>
                    </div>
                    <div class="point-frame">
                        <div class="num">4</div>
                        <div class="text">使用email或本平台，點選進入諮詢室</div>
                    </div>
                </div>
                <div class="right">
                    <div class="step-2"><img src="/wdaecPublic/assets/img/step-2.png" alt=""></div>
                    <div class="step-3"><img src="/wdaecPublic/assets/img/step-3.png" alt=""></div>
                </div>
            </div>
            <div class="step-4"><img src="/wdaecPublic/assets/img/step-4.png" alt=""></div>
        </div>
        <div class="appointment-block d-md-none">
            <div class="step-1"><img src="/wdaecPublic/assets/img/step-1.png" alt=""></div>
            <div class="point-frame">
                <div class="num">1</div>
                <div class="text">找到一個安靜的場所</div>
            </div>
            <div class="step-2"><img src="/wdaecPublic/assets/img/step-2.png" alt=""></div>
            <div class="point-frame">
                <div class="num">2</div>
                <div class="text">確認網路環境穩定</div>
            </div>
            <div class="step-3"><img src="/wdaecPublic/assets/img/step-3.png" alt=""></div>
            <div class="point-frame">
                <div class="num">3</div>
                <div class="text">準備支援影音的電子通訊設備</div>
            </div>
            <div class="step-4"><img src="/wdaecPublic/assets/img/step-4.png" alt=""></div>
            <div class="point-frame">
                <div class="num">4</div>
                <div class="text">使用email或本平台，點選進入諮詢室</div>
            </div>
        </div>
    </div>
</section>


