{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "ALL in Life — Discover to Act Product Flow",
    "subtitle": "圓山 2 km：從需求、可信資料與 CP 評分，到組隊行動",
    "locale": "zh-CN",
    "output": "docs/architecture/all-in-life-product-flow.html",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      { "id": "discover", "label": "探索與排序", "focus": ["intent", "parallel_search", "normalize", "evidence_gate", "constraints", "score", "results"], "note": "Personal 與 Zero-Cost 共用同一套正規化、證據門檻與 CP 引擎。" },
      { "id": "team", "label": "Team 成團", "focus": ["results", "report", "campaign", "join", "threshold", "act"], "note": "把社群情報轉成可驗證、可加入、可達標的協同行動。" },
      { "id": "reliability", "label": "可信度處理", "focus": ["normalize", "evidence_gate", "pending", "score"], "note": "缺少來源或過期資料不直接冒充官方事實，先進待驗證狀態。" }
    ],
    "legend": { "mode": "auto" },
    "viewBox": [900, 980]
  },
  "lanes": [
    { "id": "person", "label": "使用者 / Team" },
    { "id": "experience", "label": "Responsive PWA" },
    { "id": "intelligence", "label": "資料與 CP Intelligence" },
    { "id": "action", "label": "Community Action" },
    { "id": "exceptions", "label": "資料例外", "variant": "exception" }
  ],
  "phases": [
    { "id": "discover_phase", "label": "Discover", "fromCol": 0, "toCol": 1 },
    { "id": "compare_phase", "label": "Compare", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "act_phase", "label": "Share · Team Up · Act", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "scoring", "label": "同一套評分核心", "lane": "intelligence", "fromCol": 1, "toCol": 4, "variant": "emphasis" },
    { "id": "team_action", "label": "達標才進入外部行動", "lane": "action", "fromCol": 3, "toCol": 5, "variant": "default" }
  ],
  "mainPath": ["intent", "parallel_search", "normalize", "evidence_gate", "constraints", "score", "results"],
  "semanticChecks": {
    "allowedRoots": ["intent"],
    "allowedTerminals": ["act", "pending"],
    "requiredPaths": [
      { "from": "intent", "to": "results" },
      { "from": "results", "to": "act" },
      { "from": "evidence_gate", "to": "pending" }
    ]
  },
  "nodes": [
    { "id": "intent", "lane": "person", "col": 0, "type": "external", "label": "輸入任務", "sublabel": "需求 · 預算 · 人數", "tag": "圓山 2 km" },
    { "id": "parallel_search", "lane": "experience", "col": 1, "type": "frontend", "label": "雙軌搜尋", "sublabel": "付費餐廳 + Zero-Cost" },
    { "id": "normalize", "lane": "intelligence", "col": 1, "type": "backend", "label": "正規化", "sublabel": "場所 · 優惠 · 活動" },
    { "id": "evidence_gate", "lane": "intelligence", "col": 2, "type": "security", "label": "證據門檻", "sublabel": "來源 · 時效 · 驗證" },
    { "id": "constraints", "lane": "intelligence", "col": 3, "type": "backend", "label": "硬條件過濾", "sublabel": "距離 · 預算 · 開放" },
    { "id": "score", "lane": "intelligence", "col": 4, "width": 120, "type": "database", "label": "CP Score V1", "sublabel": "Base + Personal + Reliability" },
    { "id": "results", "lane": "experience", "col": 5, "type": "frontend", "label": "地圖 + 清單", "sublabel": "排序與證據展開" },
    { "id": "report", "lane": "person", "col": 3, "type": "external", "label": "分享情報", "sublabel": "優惠 · 踩雷 · 食安" },
    { "id": "campaign", "lane": "action", "col": 3, "type": "messagebus", "label": "建立活動", "sublabel": "最低人數與期限" },
    { "id": "join", "lane": "action", "col": 4, "type": "frontend", "label": "Join Group", "sublabel": "3 / 5 → 5 / 5" },
    { "id": "threshold", "lane": "action", "col": 5, "type": "backend", "label": "門檻達成", "sublabel": "鎖定承諾與狀態" },
    { "id": "act", "lane": "person", "col": 5, "type": "external", "label": "採取行動", "sublabel": "到店 · 團訂 · 參加" },
    { "id": "pending", "lane": "exceptions", "col": 3, "type": "security", "label": "待驗證", "sublabel": "不進正式排序" }
  ],
  "edges": [
    { "from": "intent", "to": "parallel_search", "label": "送出", "variant": "emphasis", "role": "main" },
    { "from": "parallel_search", "to": "normalize", "label": "候選資料", "role": "main" },
    { "from": "normalize", "to": "evidence_gate", "role": "main" },
    { "from": "evidence_gate", "to": "constraints", "label": "可用", "variant": "emphasis", "role": "main" },
    { "from": "constraints", "to": "score", "role": "main" },
    { "from": "score", "to": "results", "label": "排序", "variant": "emphasis", "role": "main" },
    { "from": "results", "to": "report", "label": "新增情報", "variant": "dashed", "role": "branch" },
    { "from": "report", "to": "campaign", "label": "發起揪團", "role": "main" },
    { "from": "campaign", "to": "join", "role": "main" },
    { "from": "join", "to": "threshold", "label": "達標", "variant": "emphasis", "role": "main" },
    { "from": "threshold", "to": "act", "role": "main" },
    { "from": "evidence_gate", "to": "pending", "label": "缺來源 / 過期", "variant": "security", "role": "error" }
  ],
  "cards": [
    { "dot": "cyan", "title": "單一可信資料管線", "items": ["付費與 Zero-Cost 只在探索來源不同", "進榜前都要經過正規化與證據門檻", "缺資料採 coverage penalty，不把未知當零分"] },
    { "dot": "emerald", "title": "可解釋 CP Score", "items": ["Price、Food、Quality、Convenience、Discount、Reliability", "Base Score 與個人權重分開保存", "每次評分保留 policy 版本與 component breakdown"] },
    { "dot": "rose", "title": "社群情報有狀態", "items": ["Community Report 不等於 Official Data", "食安與負面情報需來源、時間與可信度", "團體門檻達成後才進入外部履約"] }
  ]
}
