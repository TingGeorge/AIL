# One native Gemini provider for audio -> {transcript, need}, text parsing, and ranking.
# Choose a Gemini model that supports audio input + structured JSON output.
# Server-side only; never use VITE_ prefixes or commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=

PORT=3000
DATABASE_URL=postgres://localhost/ail
SUPPORT_EMAIL=

# Explicit demo mode permits importing AND publicly showing fictional fixtures.
# Keep disabled for the real researched catalog.
ALLOW_DEMO_DATA=0
# Optional candidate JSON directory; default is data/live (web-researched batch).
# For synthetic tests only: DATA_DIR=./data ALLOW_DEMO_DATA=1
DATA_DIR=
